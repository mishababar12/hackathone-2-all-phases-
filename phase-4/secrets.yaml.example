# Kubernetes Secrets for Todo Chatbot Backend
# Copy this file to secrets.yaml and fill in your actual values
# Then apply: kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: todo-backend-secrets
type: Opaque
stringData:
  DATABASE_URL: "postgresql://user:password@host/database?sslmode=require"
  OPENAI_API_KEY: "sk-your-openai-api-key-here"
  BETTER_AUTH_SECRET: "your-jwt-secret-here-minimum-32-chars"
